{
  "name": "texas-holdem-saloon",
  "version": "0.1.0",
  "private": true,
  "description": "Local-network browser Texas Holdem poker with an interactive tutorial — western saloon theme",
  "license": "MIT",
  "workspaces": [
    "shared",
    "server",
    "frontend"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:server": "npm run test -w server",
    "build": "npm run build -w frontend",
    "start": "npm run start -w server",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w frontend"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
